[Unit]
Description=HawkEye Preview Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yk/previews/Hawk_I-parkicheck-safety/backend
EnvironmentFile=/home/yk/.config/hawkeye-backend/backend.env
Environment=PATH=/home/yk/projects/Hawk_I/.venv-py311/bin:/home/yk/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p /home/yk/.local/state/hawkeye-preview/uploads
ExecStart=/usr/bin/env UPLOAD_FOLDER=/home/yk/.local/state/hawkeye-preview/uploads /home/yk/projects/Hawk_I/.venv-py311/bin/gunicorn app:app --bind 127.0.0.1:5892 --workers 1 --timeout 300
Restart=always
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
